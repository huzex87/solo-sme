.sidebar {
  width: var(--sidebar-width);
  height: 100vh;
  background: var(--sidebar-bg);
  border-right: 1px solid rgba(255,255,255,.05);
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  z-index: 50;
  flex-shrink: 0;
  overflow: hidden;
}

.sidebar::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 260px 300px at 100% 0%, rgba(0,121,140,.15) 0%, transparent 60%),
    radial-gradient(ellipse 200px 200px at 0% 100%, rgba(245,166,35,.07) 0%, transparent 60%);
  pointer-events: none;
}

.sidebarHeader {
  padding: 22px 20px 18px;
  border-bottom: 1px solid rgba(255,255,255,.05);
  position: relative;
  z-index: 1;
}

.sidebarLogo {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 900;
  color: #fff;
  letter-spacing: -.05em;
  line-height: 1;
}
.sidebarLogo span { color: var(--accent); }

.logoTag {
  margin-top: 4px;
  font-size: 9px;
  font-weight: 800;
  color: rgba(255,255,255,.2);
  text-transform: uppercase;
  letter-spacing: .18em;
}

.nav {
  flex: 1;
  padding: 16px 10px;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  position: relative;
  z-index: 1;
}
.nav::-webkit-scrollbar { display: none; }

.navGroup { margin-bottom: 26px; }

.navLabel {
  font-size: 9.5px;
  font-weight: 800;
  color: rgba(255,255,255,.2);
  text-transform: uppercase;
  letter-spacing: .14em;
  padding: 0 10px;
  margin-bottom: 7px;
}

.navLink {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 10px;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 600;
  color: rgba(255,255,255,.45);
  transition: var(--transition);
  margin-bottom: 1px;
  position: relative;
}
.navLink:hover {
  background: rgba(255,255,255,.05);
  color: rgba(255,255,255,.85);
}

.navLinkActive {
  background: rgba(245,166,35,.12);
  color: var(--accent);
  font-weight: 700;
}
.navLinkActive::before {
  content: "";
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 3px; height: 60%;
  background: var(--accent);
  border-radius: 0 3px 3px 0;
}

.navIcon { flex-shrink: 0; opacity: .6; transition: var(--transition); }
.navLink:hover .navIcon { opacity: .9; }
.navLinkActive .navIcon { opacity: 1; color: var(--accent); }

.sidebarFooter {
  padding: 14px;
  border-top: 1px solid rgba(255,255,255,.05);
  position: relative;
  z-index: 1;
}

.merchantCard {
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 10px;
  padding: 11px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  transition: var(--transition);
  cursor: pointer;
}
.merchantCard:hover {
  background: rgba(255,255,255,.08);
  border-color: rgba(255,255,255,.12);
}

.merchantAvatar {
  width: 30px; height: 30px;
  border-radius: 8px;
  background: var(--accent);
  display: flex; align-items: center; justify-content: center;
  font-weight: 900; color: var(--ink); font-size: 13px;
  flex-shrink: 0;
}

.merchantInfo { flex: 1; min-width: 0; }
.merchantName {
  font-size: 12px; font-weight: 700; color: #fff;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.merchantPlan {
  font-size: 9px; color: var(--accent); font-weight: 800;
  text-transform: uppercase; letter-spacing: .06em; margin-top: 1px;
}

.viewStoreLink {
  display: flex; align-items: center; gap: 7px;
  padding: 8px 12px; margin-top: 8px;
  border-radius: 8px; font-size: 11px; font-weight: 700;
  color: rgba(255,255,255,.3); text-transform: uppercase; letter-spacing: .08em;
  transition: var(--transition); border: 1px solid rgba(255,255,255,.06);
}
.viewStoreLink:hover {
  color: var(--accent);
  border-color: rgba(245,166,35,.2);
  background: rgba(245,166,35,.05);
}

@media (max-width: 1024px) {
  .sidebar {
    position: fixed;
    transform: translateX(-100%);
    transition: transform .3s cubic-bezier(.4,0,.2,1);
  }
  .sidebarOpen {
    transform: translateX(0);
    box-shadow: var(--shadow-lg);
  }
}
