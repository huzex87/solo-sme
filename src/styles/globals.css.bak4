@import "tailwindcss/theme" layer(theme);
@import "tailwindcss/utilities" layer(utilities);
@import './tokens.css';

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html,
body {
  max-width: 100vw;
  min-height: 100vh;
  font-family: var(--font-sans);
  background: var(--surface);
  color: var(--body);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
  text-rendering: optimizeLegibility;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  display: block;
  max-width: 100%;
}

/* ── TYPOGRAPHY ─────────────────────────── */
h1,
h2,
h3,
h4,
h5,
h6 {
  color: var(--ink);
  font-family: var(--font-display);
  font-weight: 600;
  /* Institutional Semibold Standard */
  letter-spacing: -0.02em;
  line-height: 1.2;
}

h1 {
  font-size: clamp(1.75rem, 5vw, 2.5rem);
}

h2 {
  font-size: clamp(1.375rem, 4vw, 1.875rem);
}

h3 {
  font-size: clamp(1.125rem, 3vw, 1.375rem);
}

/* ── CARD (Institutional Depth) ──────────── */
.card {
  background: var(--card);
  border: none;
  /* Shadow-based separation */
  border-radius: var(--rl);
  padding: 1.5rem;
  box-shadow: var(--sh-md);
  transition: var(--transition);
}

.card:hover {
  box-shadow: var(--sh-xl);
  transform: translateY(-2px);
}

/* ── CRYSTAL CARD (Crystalline Mastery) ──── */
.crystalCard {
  background: var(--glass-bg);
  backdrop-filter: blur(var(--glass-blur));
  -webkit-backdrop-filter: blur(var(--glass-blur));
  border: var(--glass-border);
  border-radius: var(--rl);
  box-shadow: var(--sh-md);
  transition: var(--transition);
}

.crystalCard:hover {
  box-shadow: var(--sh-xl);
  transform: translateY(-2px);
}

/* ── BUTTONS ─────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 20px;
  border-radius: var(--r);
  font-weight: 600;
  font-family: var(--font-sans);
  font-size: 14px;
  border: none;
  cursor: pointer;
  transition: var(--transition);
  gap: 8px;
  white-space: nowrap;
}

.btn:active {
  transform: scale(0.97);
}

.btn:disabled {
  opacity: .5;
  cursor: not-allowed;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 2px 8px rgba(0, 121, 140, .2);
}

.btn-primary:hover:not(:disabled) {
  background: var(--primary-dk);
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(0, 121, 140, .3);
}

.btn-accent,
.btn-amber {
  background: var(--accent);
  color: var(--ink);
  box-shadow: 0 2px 8px rgba(245, 166, 35, .2);
}

.btn-accent:hover:not(:disabled),
.btn-amber:hover:not(:disabled) {
  background: var(--accent-dk);
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(245, 166, 35, .3);
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 1.5px solid var(--primary-md);
}

.btn-outline:hover:not(:disabled) {
  border-color: var(--primary);
  background: var(--primary-lt);
}

.btn-ghost {
  background: transparent;
  color: var(--body);
  border: 1.5px solid var(--border-md);
}

.btn-ghost:hover:not(:disabled) {
  border-color: var(--primary);
  color: var(--primary);
  background: var(--primary-lt);
}

.btn-secondary {
  background: var(--surface-2);
  color: var(--body);
  border: 1px solid var(--border);
}

.btn-secondary:hover:not(:disabled) {
  background: var(--border);
  color: var(--ink);
}

.btn-danger {
  background: var(--danger-lt);
  color: var(--danger);
  border: 1px solid rgba(192, 57, 43, .2);
}

.btn-danger:hover:not(:disabled) {
  background: var(--danger);
  color: #fff;
}

.btn-xs {
  padding: 4px 10px;
  font-size: 11px;
  border-radius: 6px;
}

.btn-sm {
  padding: 6px 14px;
  font-size: 12px;
}

.btn-lg {
  padding: 13px 28px;
  font-size: 14px;
  border-radius: var(--rl);
  font-weight: 800;
}

.btn-xl {
  padding: 16px 36px;
  font-size: 15px;
  border-radius: var(--rx);
  font-weight: 800;
}

/* ── INPUT ───────────────────────────────── */
.input-field {
  width: 100%;
  padding: 11px 14px;
  background: var(--card);
  border: 1.5px solid var(--border);
  border-radius: var(--rl);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: 500;
  transition: var(--transition);
  outline: none;
}

.input-field::placeholder {
  color: var(--ghost);
}

.input-field:focus {
  border-color: var(--primary);
  box-shadow: var(--glow-primary);
}

/* ── BADGES ──────────────────────────────── */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 10px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 700;
  text-transform: capitalize;
  letter-spacing: .02em;
}

.badge-success {
  background: var(--success-lt);
  color: var(--success);
}

.badge-warning {
  background: var(--warning-lt);
  color: var(--warning);
}

.badge-error {
  background: var(--danger-lt);
  color: var(--danger);
}

.badge-info {
  background: var(--info-lt);
  color: var(--info);
}

.badge-ghost {
  background: var(--surface-2);
  color: var(--muted);
  border: 1px solid var(--border);
}

.badge-purple {
  background: var(--purple-lt);
  color: var(--purple);
}

.badge-teal {
  background: var(--primary-lt);
  color: var(--primary);
}

.badge-amber {
  background: var(--accent-lt);
  color: var(--accent-dk);
}

/* ── TABLE ───────────────────────────────── */
.table-container {
  overflow-x: auto;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.data-table th {
  text-align: left;
  padding: 12px 16px;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--muted);
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}

.data-table td {
  padding: 13px 16px;
  border-bottom: 1px solid var(--border);
  color: var(--body);
  vertical-align: middle;
}

.data-table tbody tr {
  transition: background .12s;
}

.data-table tbody tr:hover {
  background: var(--surface);
}

.data-table tbody tr:last-child td {
  border-bottom: none;
}

/* ── ICON BACKGROUNDS ────────────────────── */
.icon-bg {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-bg-green {
  background: var(--success-lt);
  color: var(--success);
}

.icon-bg-amber {
  background: var(--accent-lt);
  color: var(--accent-dk);
}

.icon-bg-blue {
  background: var(--info-lt);
  color: var(--info);
}

.icon-bg-red {
  background: var(--danger-lt);
  color: var(--danger);
}

.icon-bg-teal {
  background: var(--primary-lt);
  color: var(--primary);
}

.icon-bg-purple {
  background: var(--purple-lt);
  color: var(--purple);
}

/* ── ACCENT CARD TOPS ────────────────────── */
.card-accent-green {
  border-top: 3px solid var(--accent-revenue) !important;
}

.card-accent-amber {
  border-top: 3px solid var(--accent-customers) !important;
}

.card-accent-blue {
  border-top: 3px solid var(--accent-orders) !important;
}

.card-accent-teal {
  border-top: 3px solid var(--accent-products) !important;
}

.card-accent-purple {
  border-top: 3px solid var(--accent-marketing) !important;
}

.card-accent-red {
  border-top: 3px solid var(--danger) !important;
}

.card-accent-finance {
  border-top: 3px solid var(--accent-finance) !important;
}

/* ── GLASS UTILITIES ─────────────────────── */
.glass {
  background: rgba(255, 255, 255, .55);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, .25);
}

.crystalline {
  background: var(--glass-bg);
  backdrop-filter: blur(var(--glass-blur));
  -webkit-backdrop-filter: blur(var(--glass-blur));
  border: var(--glass-border);
}

.glow-primary {
  box-shadow: var(--glow-primary);
}

.glow-accent {
  box-shadow: 0 0 0 3px rgba(245, 166, 35, .22);
}

.glow-amber {
  box-shadow: var(--glow-amber);
}

.glow-green {
  box-shadow: var(--glow-success);
}

.glow-purple {
  box-shadow: 0 0 0 3px rgba(124, 58, 237, .2);
}

.glow-revenue {
  filter: drop-shadow(0 0 6px rgba(10, 140, 79, .2));
}

.glow-orders {
  filter: drop-shadow(0 0 6px rgba(46, 99, 142, .2));
}

.glow-customers {
  filter: drop-shadow(0 0 6px rgba(217, 119, 6, .2));
}

/* ── OBSIDIAN MOCKUP community ──────────────────── */
.dh {
  background: linear-gradient(160deg, var(--ink) 0%, var(--ink80) 100%);
  padding: 40px 18px 24px;
  position: relative;
  overflow: hidden;
}

.dh::before {
  content: '';
  position: absolute;
  top: -40px;
  right: -40px;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(64, 158, 242, .18) 0%, transparent 70%);
}

.wa-fab {
  width: 44px;
  height: 44px;
  background: var(--green);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -18px;
  box-shadow: var(--sh-green);
  position: relative;
}

.wa-fab::after {
  content: 'AI';
  position: absolute;
  top: -5px;
  right: -5px;
  background: var(--blue);
  color: white;
  font-size: 7px;
  font-weight: 800;
  padding: 1px 4px;
  border-radius: 999px;
  letter-spacing: .05em;
  border: 1.5px solid var(--card);
}

.beta-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 9px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 999px;
  background: rgba(64, 158, 242, .2);
  color: #7EC8FF;
  border: 1px solid rgba(64, 158, 242, .25);
}

.beta-chip::before {
  content: '';
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--blue);
  animation: pulse 2s infinite;
}

/* ── LAYOUT UTILS ────────────────────────── */
.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.items-center {
  align-items: center;
}

.justify-between {
  justify-content: space-between;
}

.gap-2 {
  gap: 8px;
}

.gap-4 {
  gap: 16px;
}

.gap-6 {
  gap: 24px;
}

.mt-4 {
  margin-top: 16px;
}

.w-full {
  width: 100%;
}

/* ── TEXT UTILS ──────────────────────────── */
.text-xs {
  font-size: 11px;
}

.text-sm {
  font-size: 13px;
}

.text-secondary {
  color: var(--muted);
}

.text-center {
  text-align: center;
}

.font-mono {
  font-family: var(--font-mono);
}

.font-bold {
  font-weight: 700;
}

.font-semibold {
  font-weight: 600;
}

/* ── RADIANT BG ──────────────────────────── */
.radiant-bg {
  position: relative;
  overflow: hidden;
}

.radiant-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--radiant-glow);
  pointer-events: none;
  opacity: .8;
}

/* ── SKELETON LOADING SHIMMER ────────────── */
.skeleton {
  background: linear-gradient(90deg, var(--surface-2) 25%, var(--border) 50%, var(--surface-2) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 6px;
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }

  100% {
    background-position: -200% 0;
  }
}

/* ── ANIMATIONS ──────────────────────────── */
@keyframes entrance {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-entrance {
  animation: entrance .5s cubic-bezier(.2, 0, 0, 1) both;
}

@keyframes pulse {

  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: .5;
  }
}

.animate-pulse {
  animation: pulse 2s cubic-bezier(.4, 0, .6, 1) infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.animate-spin {
  animation: spin 1s linear infinite;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

.animate-fade {
  animation: fadeIn .3s ease both;
}

/* ═══════════════════════════════════════════════════════════════════════════════
   RESPONSIVE — Mobile-First System
   768px = tablet breakpoint, 480px = phone
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Visibility ── */
.mobile-only {
  display: none !important;
}

.desktop-only {
  display: flex;
  flex-shrink: 0;
}

/* ── Safe-area CSS custom properties ── */
:root {
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --mobile-nav-h: 0px;
}

/* ── Desktop defaults ── */
.mobile-bottom-pad {
  padding-bottom: 0;
}

/* ─── TABLET & MOBILE ( ≤ 1024px ) ─────────────────────────────────────────── */
@media (max-width: 1024px) {
  :root {
    --mobile-nav-h: 64px;
  }

  .mobile-only {
    display: flex !important;
  }

  .desktop-only {
    display: none !important;
  }

  /* ── Mobile bottom padding for main content ── */
  .mobile-bottom-pad {
    padding-bottom: calc(var(--mobile-nav-h) + var(--safe-bottom) + 8px) !important;
  }

  /* ── Touch-friendly targets (Apple HIG: 44pt) ── */
  .btn {
    min-height: 44px;
    padding: 10px 16px;
    font-size: 14px;
  }

  .btn-xs {
    min-height: 36px;
    padding: 7px 12px;
  }

  .btn-sm {
    min-height: 40px;
  }

  .input-field {
    min-height: 44px;
    font-size: 16px !important;
    /* prevents iOS zoom */
  }

  select {
    min-height: 44px;
    font-size: 16px !important;
  }

  /* ── Typography scale-down ── */
  h1 {
    font-size: clamp(18px, 5vw, 22px) !important;
  }

  h2 {
    font-size: clamp(16px, 4vw, 20px) !important;
  }

  h3 {
    font-size: clamp(14px, 3.5vw, 16px) !important;
  }

  /* ── Cards: slightly tighter ── */
  .card {
    border-radius: 12px;
  }

  .crystalCard {
    border-radius: 12px;
  }

  /* ── Data tables: horizontal scroll ── */
  .table-container {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .data-table {
    min-width: 600px;
  }

  .data-table th,
  .data-table td {
    padding: 10px 12px;
    font-size: 12px;
    white-space: nowrap;
  }

  /* ── Native-like scroll ── */
  * {
    -webkit-overflow-scrolling: touch;
  }

  ::-webkit-scrollbar {
    width: 0;
    height: 0;
    display: none;
  }

  html {
    scrollbar-width: none;
  }

  /* ── Prevent horizontal overflow on mobile ── */
  html,
  body {
    overflow-x: hidden !important;
    max-width: 100vw !important;
  }

  /* ── Haptic-like pressed states ── */
  .btn:active,
  a:active {
    transform: scale(0.97);
    transition: transform 0.08s ease;
  }

  /* ── Bottom nav glass support ── */
  .mobile-glass-bar {
    background: rgba(255, 255, 255, 0.88) !important;
    backdrop-filter: blur(20px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
  }
}

/* ─── PHONE ONLY ( ≤ 480px ) ──────────────────────────────────────────────── */
@media (max-width: 480px) {
  .card {
    padding: 14px;
  }

  .btn {
    border-radius: 10px;
  }
}

/* ── Reduced motion support ── */
@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}